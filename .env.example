# Exemplo: guardar em /etc/qualigest-sgo.env, fora da pasta publica.
# Substitua DOMINIO, remetente, chave de API e caminhos antes da publicacao.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=https://sgo.empresa.exemplo
ALLOWED_EMAIL_DOMAIN=britania.com.br
SGO_DATA_DIR=/var/lib/qualigest-sgo
SGO_BACKUP_DIR=/var/backups/qualigest-sgo
SGO_BACKUP_RETENTION_DAYS=30
MAIL_PROVIDER=resend
MAIL_FROM="QualiGest <acesso@empresa.exemplo>"
RESEND_API_KEY=CONFIGURAR_NO_GERENCIADOR_DE_SEGREDOS
# ADMIN_INITIAL_PASSWORD somente para a CRIACAO inicial do banco; REMOVER depois.
